<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Портфолио | Линити</title>
    <link rel="stylesheet" href="/css/portfolio.css">
        <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/confirm-modal.css">
    <link rel="stylesheet" href="/css/header.css">
</head>
<body>
    <main>
        <%- include('partials/header-actions') %>
        <% const profileUpdatedSafe = Boolean(typeof profileUpdated !== 'undefined' && profileUpdated); %>
        <% const workCreatedSafe = Boolean(typeof workCreated !== 'undefined' && workCreated); %>
        <% const workUpdatedSafe = Boolean(typeof workUpdated !== 'undefined' && workUpdated); %>
        <% if (profileUpdatedSafe || workCreatedSafe || workUpdatedSafe) { %>
            <div class="profile-toast" id="profileToast" role="status" aria-live="polite">
                <%= profileUpdatedSafe ? 'Профиль успешно обновлён' : (workUpdatedSafe ? 'Работа успешно отредактирована' : 'Работа отправлена на модерацию') %>
            </div>
        <% } %>

        <section class="profile-works portfolio-page-content">
            <div class="portfolio-toolbar">
                <h1>Портфолио <%= !isOwnProfile ? ('— ' + portfolioUser.first_name + ' ' + portfolioUser.last_name) : '' %></h1>
                <% if (isOwnProfile) { %>
                <button type="button" class="create-collection-btn" id="openCollectionModal">+ Создать сборник</button>
                <% } %>
            </div>
            <div class="orders-tabs portfolio-tabs" role="tablist" aria-label="Разделы портфолио">
                <button type="button" class="tab-btn active" data-portfolio-tab="collections" aria-selected="true">Сборники</button>
                <button type="button" class="tab-btn" data-portfolio-tab="works" aria-selected="false">Все работы</button>
            </div>

            <div class="portfolio-tab-panel" data-portfolio-panel="collections">
                <div class="portfolio-collections" id="portfolioCollections"></div>
            </div>

            <div class="portfolio-tab-panel" data-portfolio-panel="works" hidden>
                <% if (isOwnProfile && pendingWorks && pendingWorks.length) { %>
                    <div class="pending-works">
                        <button class="pending-works-toggle" type="button" data-pending-toggle aria-expanded="false">
                            <span>На модерации</span>
                            <span class="pending-works-count"><%= pendingWorks.length %></span>
                        </button>
                        <div class="pending-works-content" data-pending-content hidden>
                            <div class="pending-works-list">
                                <% pendingWorks.forEach(work => { %>
                                    <div class="pending-work-item">
                                        <div class="pending-work-item-head">
                                            <h3><%= work.title %></h3>
                                            <span><%= new Date(work.created_at).toLocaleDateString('ru-RU') %></span>
                                        </div>
                                        <p>Работа отправлена на модерацию и станет доступна после проверки.</p>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                <% } %>
                <div class="works-grid">
                    <% activeWorks.forEach(work => { %>
                        <div class="work-card" data-work-id="<%= work.id %>">
                            <% if (isOwnProfile) { %>
                            <a class="edit-work-btn" href="/works/<%= work.id %>/edit" title="Редактировать работу" aria-label="Редактировать работу">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M16.4767 3.00405C16.6443 3.01998 16.7166 3.22345 16.5976 3.34248L8.27746 11.6626C8.18323 11.7568 8.11581 11.8744 8.08213 12.0034L7.08213 15.8318C7.01484 16.0894 7.08918 16.3634 7.27746 16.5517C7.46573 16.7399 7.73971 16.8143 7.99733 16.747L11.8258 15.747C11.9547 15.7133 12.0723 15.6459 12.1665 15.5517L20.6045 7.11374C20.7229 6.99535 20.9253 7.06618 20.9427 7.23269C21.2943 10.5819 21.2744 13.9602 20.8831 17.3061C20.6603 19.2111 19.1291 20.7069 17.2307 20.9191C13.7825 21.3044 10.2178 21.3044 6.76972 20.9191C4.87132 20.7069 3.34013 19.2111 3.11732 17.3061C2.70504 13.7811 2.70504 10.22 3.11732 6.69501C3.34013 4.78995 4.87132 3.29418 6.76972 3.082C9.96711 2.72465 13.2647 2.69866 16.4767 3.00405Z" fill="#393939"/>
                                    <path d="M17.8235 4.23781C17.9211 4.14037 18.0792 4.14037 18.1768 4.23781L19.5912 5.65217C19.6888 5.7498 19.6888 5.90809 19.5912 6.00572L11.2977 14.2991C11.2665 14.3304 11.2269 14.353 11.1841 14.3643L9.26973 14.8643C9.08509 14.9124 8.91694 14.7438 8.96487 14.5592L9.46487 12.645C9.47609 12.602 9.49857 12.5628 9.52998 12.5314L17.8235 4.23781Z" fill="#393939"/>
                                </svg>

                            </a>
                            <button class="delete-work-btn" type="button" data-delete-work aria-label="Удалить работу" title="Удалить работу">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M9.25 3C9.25 2.58579 9.58579 2.25 10 2.25H14C14.4142 2.25 14.75 2.58579 14.75 3V3.75H19C19.4142 3.75 19.75 4.08579 19.75 4.5C19.75 4.91421 19.4142 5.25 19 5.25H5C4.58579 5.25 4.25 4.91421 4.25 4.5C4.25 4.08579 4.58579 3.75 5 3.75H9.25V3Z" fill="#393939"/>
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M6.2399 7.94478C6.26803 7.69157 6.48206 7.5 6.73684 7.5H17.2632C17.5179 7.5 17.732 7.69157 17.7601 7.94478L17.9602 9.74613C18.321 12.9931 18.321 16.2701 17.9602 19.517L17.9405 19.6944C17.8091 20.8769 16.8926 21.8199 15.7143 21.9849C13.2501 22.3299 10.7499 22.3299 8.28574 21.9849C7.10737 21.8199 6.19085 20.8769 6.05945 19.6944L6.03975 19.517C5.67897 16.2701 5.67897 12.9931 6.03975 9.74613L6.2399 7.94478ZM10.75 11.4C10.75 10.9858 10.4142 10.65 10 10.65C9.58579 10.65 9.25 10.9858 9.25 11.4L9.25 18.4C9.25 18.8142 9.58579 19.15 10 19.15C10.4142 19.15 10.75 18.8142 10.75 18.4L10.75 11.4ZM14.75 11.4C14.75 10.9858 14.4142 10.65 14 10.65C13.5858 10.65 13.25 10.9858 13.25 11.4V18.4C13.25 18.8142 13.5858 19.15 14 19.15C14.4142 19.15 14.75 18.8142 14.75 18.4V11.4Z" fill="#393939"/>
                                </svg>
                            </button>
                            <% } %>
                            <% const portfolioImages = (work.images && work.images.length ? work.images : ['/img/work_img.svg']); %>
                            <div class="work-gallery" data-gallery>
                                <button class="gallery-arrow gallery-arrow-left" type="button" data-gallery-prev aria-label="Предыдущее изображение">&#10094;</button>
                                <div class="work-image-track" data-gallery-track>
                                    <% portfolioImages.forEach((imageUrl, idx) => { %>
                                        <div class="work-image">
                                            <img src="<%= imageUrl %>" alt="<%= work.title %> — изображение <%= idx + 1 %>" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/img/work_img.svg';">
                                        </div>
                                    <% }) %>
                                </div>
                                <button class="gallery-arrow gallery-arrow-right" type="button" data-gallery-next aria-label="Следующее изображение">&#10095;</button>
                            </div>
                            <div class="work-info">
                                <h3><%= work.title %></h3>
                                <p class="work-description"><%= work.description || 'Описание не добавлено.' %></p>
                                <a class="view-work-btn" href="/works/<%= work.id %>">Просмотреть работу</a>
                                <div class="work-card-footer">
                                    <button
                                        class="post-like-btn <%= work.is_liked ? 'is-liked' : '' %>"
                                        type="button"
                                        data-work-id="<%= work.id %>"
                                        data-liked="<%= work.is_liked ? 'true' : 'false' %>"
                                        aria-pressed="<%= work.is_liked ? 'true' : 'false' %>"
                                        aria-label="Поставить лайк проекту"
                                    >
                                        <svg width="20" height="20" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                            <path d="M16 28C15.5985 27.9995 15.2065 27.8782 14.875 27.6519C9.96309 24.3175 7.83621 22.0312 6.66309 20.6019C4.16309 17.555 2.96621 14.4269 2.99996 11.0394C3.03934 7.1575 6.15371 4 9.94246 4C12.6975 4 14.6056 5.55188 15.7168 6.84438C15.752 6.88491 15.7955 6.91741 15.8444 6.93968C15.8932 6.96195 15.9463 6.97348 16 6.97348C16.0536 6.97348 16.1067 6.96195 16.1555 6.93968C16.2044 6.91741 16.2479 6.88491 16.2831 6.84438C17.3943 5.55063 19.3025 4 22.0575 4C25.8462 4 28.9606 7.1575 29 11.04C29.0337 14.4281 27.8356 17.5563 25.3368 20.6025C24.1637 22.0319 22.0368 24.3181 17.125 27.6525C16.7933 27.8786 16.4013 27.9997 16 28Z" fill="none" stroke="#696969" stroke-width="3px"/>
                                        </svg>
                                        <span class="post-like-count"><%= work.likes || 0 %></span>
                                    </button>
                                    <p class="post-bottom-data"><%= new Date(work.created_at).toLocaleDateString('ru-RU') %></p>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </section>
    </main>
    <%- include('partials/confirm-modal') %>
    <script>
        function showConfirm(message, onConfirm, options = {}) {
            const modal = document.getElementById('confirmModal');
            const titleEl = document.getElementById('confirmModalTitle');
            const msgEl = document.getElementById('confirmModalMessage');
            const okBtn = document.getElementById('confirmModalOk');
            const cancelBtn = document.getElementById('confirmModalCancel');
            titleEl.textContent = options.title || 'Подтвердите действие';
            msgEl.textContent = message;
            okBtn.textContent = options.confirmText || 'Подтвердить';
            cancelBtn.style.display = options.hideCancel ? 'none' : 'inline-block';
            modal.style.display = 'flex';
            const cleanup = () => { modal.style.display = 'none'; okBtn.onclick = null; };
            okBtn.onclick = () => { cleanup(); onConfirm(); };
            cancelBtn.onclick = cleanup;
        }
        function closeConfirm() {
            document.getElementById('confirmModal').style.display = 'none';
        }
        function showAlert(message) {
            showConfirm(message, () => {}, { title: 'Внимание', confirmText: 'OK', hideCancel: true });
        }
    </script>

    <div id="workViewerModal" class="work-viewer-modal" aria-hidden="true">
        <div class="work-viewer-overlay" data-close-work-viewer></div>
        <div class="work-viewer-content" role="dialog" aria-modal="true" aria-label="Просмотр работы">
            <button class="work-viewer-close" type="button" data-close-work-viewer aria-label="Закрыть">&times;</button>
            <h3 id="workViewerTitle"></h3>
            <div class="work-viewer-gallery" data-viewer-gallery>
                <button class="gallery-arrow gallery-arrow-left" type="button" data-viewer-prev aria-label="Предыдущее изображение">&#10094;</button>
                <div class="work-viewer-track" id="workViewerTrack"></div>
                <button class="gallery-arrow gallery-arrow-right" type="button" data-viewer-next aria-label="Следующее изображение">&#10095;</button>
            </div>
            <div class="work-viewer-dots" id="workViewerDots"></div>
            <p id="workViewerDescription"></p>
            <div id="workViewerStats" class="work-stats"></div>
        </div>
    </div>

    <div id="deleteWorkModal" class="delete-work-modal" aria-hidden="true">
        <div class="delete-work-modal-overlay" data-close-delete-modal></div>
        <div class="delete-work-modal-content" role="dialog" aria-modal="true" aria-labelledby="deleteWorkModalTitle">
            <button class="delete-work-modal-close" type="button" data-close-delete-modal aria-label="Закрыть">&times;</button>
            <h2 id="deleteWorkModalTitle">Удалить работу</h2>
            <form class="delete-work-form" id="deleteWorkForm">
                <div class="delete-work-form-group">
                    <p class="delete-work-modal-text">
                        Вы уверены, что хотите удалить эту работу? <br>Действие нельзя отменить.
                    </p>
                </div>
                <p class="delete-work-validation-error" id="deleteWorkValidationError" role="alert" style="display:none;"></p>
                <button type="submit" class="delete-work-submit-btn">Удалить</button>
            </form>
            <div class="report-success-state" id="deleteWorkSuccessState">
                <div class="success-content" role="status">
