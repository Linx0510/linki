<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profileUser.first_name %> <%= profileUser.last_name %> | Линити</title>
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/confirm-modal.css">
    <link rel="stylesheet" href="/css/header.css">
</head>
<body>
    <main>
        <%- include('partials/header-actions') %>
        <% if (profileUpdated || workCreated || workUpdated) { %>
            <div class="profile-toast" id="profileToast" role="status" aria-live="polite">
                <%= profileUpdated ? 'Профиль успешно обновлён' : (workUpdated ? 'Работа успешно отредактирована' : 'Работа отправлена на модерацию') %>
            </div>
        <% } %>

        <div class="profile-container">
            <div class="contentprof">
                <% if (profileUser.bio) { %>
                    <div class="profile-bio">
                        <h3>О себе</h3>
                        <p><%= profileUser.bio %></p>
                    </div>
                <% } %>

                <div class="profile-works">
                    <div class="profile-works-header">
                        <h2>Последние работы</h2>
                        <a class="view-work-btn" href="/portfolio/<%= profileUser.id %>">Перейти в портфолио</a>
                    </div>
                    <% if (works && works.length > 0) { %>
                        <div class="recent-works-grid">
                            <% works.slice(0, 4).forEach(work => { %>
                                <div class="recent-work-card">
                                    <a href="/works/<%= work.id %>">
                                        <% const previewImage = (work.images && work.images.length) ? work.images[0] : '/img/work_img.svg'; %>
                                        <div class="recent-work-image">
                                            <img src="<%= previewImage %>" alt="<%= work.title %>" loading="lazy" onerror="this.onerror=null;this.src='/img/work_img.svg';">
                                        </div>
                                        <h3><%= work.title %></h3>
                                    </a>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="no-works-text">Пока нет опубликованных работ.</p>
                    <% } %>
                </div>

                <% const dealStatusTexts = STATUS_LABELS_BY_CONTEXT.deal; %>
                <div class="profile-works profile-deals-section">
                    <div class="profile-works-header">
                        <h2>Последние сделки</h2>
                        <% if (isOwnProfile) { %>
                            <a class="view-work-btn" href="/deals">Перейти к сделкам</a>
                        <% } %>
                    </div>
                    <% if (deals && deals.length > 0) { %>
                        <div class="recent-deals-grid">
                            <% deals.forEach(deal => { %>
                                <% const isCustomerDeal = profileUser.id === deal.customer_id; %>
                                <% const partnerName = isCustomerDeal
                                    ? ((deal.executor_first_name || deal.executor_last_name) ? ((deal.executor_first_name || '') + ' ' + (deal.executor_last_name || '')) : 'Исполнитель не назначен')
                                    : ((deal.customer_first_name || deal.customer_last_name) ? ((deal.customer_first_name || '') + ' ' + (deal.customer_last_name || '')) : 'Заказчик не указан'); %>
                                <% const totalStages = Number(deal.total_stages || 0); %>
                                <% const completedStages = Number(deal.completed_stages || 0); %>
                                <% const progress = totalStages ? Math.round((completedStages / totalStages) * 100) : 0; %>
                                <article class="recent-deal-card">
                                    <a href="/deals/<%= deal.id %>">
                                        <div class="recent-deal-topline">
                                            <span>Сделка #<%= deal.id %></span>
                                            <b class="recent-deal-status status-<%= deal.status %>"><%= dealStatusTexts[deal.status] || statusLabel(deal.status, 'deal') %></b>
                                        </div>
                                        <h3><%= deal.title || 'Сделка без названия' %></h3>
                                        <div class="recent-deal-meta">
                                            <span><%= isCustomerDeal ? 'Заказчик' : 'Исполнитель' %></span>
                                            <strong><%= Number(deal.price || 0).toLocaleString('ru-RU') %> ₽</strong>
                                        </div>
                                        <p class="recent-deal-partner"><%= isCustomerDeal ? 'Исполнитель' : 'Заказчик' %>: <%= partnerName %></p>
                                        <div class="recent-deal-progress" aria-label="Прогресс этапов">
                                            <div class="recent-deal-progress-label">
                                                <span>Этапы: <%= completedStages %>/<%= totalStages %></span>
                                                <span><%= progress %>%</span>
                                            </div>
                                            <div class="recent-deal-progress-track">
                                                <span style="width: <%= progress %>%"></span>
                                            </div>
                                        </div>
                                        <p class="recent-deal-date">Дедлайн: <%= deal.deadline ? new Date(deal.deadline).toLocaleDateString('ru-RU') : 'не указан' %></p>
                                    </a>
                                </article>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="no-works-text">Пока нет сделок.</p>
                    <% } %>
                </div>

                <div class="profile-works profile-reviews-section">
                    <div class="profile-works-header">
                        <h2>Последние отзывы</h2>
                         <% if (isOwnProfile) { %>
                          <a class="view-work-btn" href="/users/<%= profileUser.id %>/review">Перейти к отзывам</a>
                        <% } %>

                        <% if (!isOwnProfile) { %>
                            <a class="view-work-btn" href="/users/<%= profileUser.id %>/review">Оставить отзыв</a>
                        <% } %>
                    </div>
                    <% if (reviews && reviews.length > 0) { %>
                        <div class="recent-reviews-grid">
                            <% reviews.forEach(review => { %>
                                <% const reviewerName = ((review.first_name || '') + ' ' + (review.last_name || '')).trim() || 'Пользователь'; %>
                                <article class="recent-review-card">
                                    <div class="recent-review-header">
                                        <a class="recent-review-author" href="/profile/<%= review.reviewer_id %>">
                                            <img src="<%= review.avatar || '/img/Group.svg' %>" alt="<%= reviewerName %>" loading="lazy">
                                            <span><%= reviewerName %></span>
                                        </a>
                                        <span class="recent-review-date"><%= review.created_at ? new Date(review.created_at).toLocaleDateString('ru-RU') : '' %></span>
                                    </div>
                                    <div class="recent-review-rating" aria-label="Оценка <%= review.rating %> из 5">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <span class="<%= i <= Number(review.rating || 0) ? 'is-active' : '' %>">★</span>
                                        <% } %>
                                    </div>
                                    <% if (review.comment) { %>
                                        <p><%= review.comment %></p>
                                    <% } else { %>
                                        <p class="recent-review-empty">Отзыв оставлен без комментария.</p>
                                    <% } %>
                                </article>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="no-works-text">Пока нет отзывов.</p>
                    <% } %>
                </div>
            </div>
            <div class="profile-header">
                <div class="profile-avatar">
                    <img src="<%= profileUser.avatar || '/img/Group.svg' %>" alt="Аватар">
                </div>


                <div class="profile-info">
                    <h1><%= profileUser.first_name %> <%= profileUser.last_name %></h1>
                    <p class="profile-email"><%= profileUser.email %></p>
                    <% if (!isOwnProfile) { %>
                        <div class="profile-actions">
                            <button class="subscribe-btn" data-user-id="<%= profileUser.id %>" data-subscribed="<%= isSubscribed ? 'true' : 'false' %>">
                                <%= isSubscribed ? 'Отписаться' : 'Подписаться' %>
                            </button>
                            <a class="mess-btn" href="/chat?user=<%= profileUser.id %>" aria-label="Написать пользователю">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M7.28924 4.90761C10.4239 4.63513 13.5763 4.63512 16.7109 4.90761L18.2211 5.03889C19.2265 5.12629 20.0876 5.72596 20.5337 6.58374C20.5908 6.69347 20.548 6.82633 20.4428 6.89144L14.1769 10.7704C12.833 11.6023 11.1385 11.6197 9.77778 10.8157L3.46995 7.08833C3.36804 7.02811 3.32126 6.90415 3.36719 6.79505C3.77535 5.82548 4.69298 5.1333 5.77901 5.0389L7.28924 4.90761Z" fill="white"/>
                                    <path d="M3.36206 8.76688C3.20609 8.67472 3.00709 8.7739 2.98891 8.95414C2.73518 11.4698 2.79659 14.0092 3.17314 16.5133C3.37166 17.8334 4.44907 18.8455 5.77901 18.9611L7.28924 19.0924C10.4239 19.3649 13.5763 19.3649 16.7109 19.0924L18.2211 18.9611C19.5511 18.8455 20.6285 17.8334 20.827 16.5133C21.2145 13.9363 21.2683 11.3217 20.9882 8.73428C20.9686 8.55276 20.7662 8.45541 20.611 8.55151L14.9664 12.0458C13.1482 13.1713 10.8557 13.1949 9.01468 12.1071L3.36206 8.76688Z" fill="white"/>
                                </svg>
                            </a>
                        </div>

                    <% } else { %>
                        <div class="profile-actions">
                            <a href="/settings" class="edit-profile-btn">Настройки</a>
                            <a href="/works/create" class="create-work-btn">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12.75 7C12.75 6.58579 12.4142 6.25 12 6.25C11.5858 6.25 11.25 6.58579 11.25 7V11.25H7C6.58579 11.25 6.25 11.5858 6.25 12C6.25 12.4142 6.58579 12.75 7 12.75H11.25V17C11.25 17.4142 11.5858 17.75 12 17.75C12.4142 17.75 12.75 17.4142 12.75 17V12.75H17C17.4142 12.75 17.75 12.4142 17.75 12C17.75 11.5858 17.4142 11.25 17 11.25H12.75V7Z" fill="white"/>
                                </svg>
                            </a>
                        </div>
                    <% } %>
                    <div class="profile-stats">
                        <div class="stat">
                            <span class="stat-value"><%= Number(profileUser.avg_rating || 0).toFixed(1) %></span>
                            <span class="stat-label">Рейтинг</span>
                        </div>
                        <div class="stat">
                            <span class="stat-value"><%= followersCount %></span>
                            <span class="stat-label">Подписчиков</span>
                        </div>
                        <div class="stat">
                            <span class="stat-value"><%= works.length %></span>
                            <span class="stat-label">Работ</span>
                        </div>
                    </div>
                    <% if (!isOwnProfile) { %>

                    <% } else { %>
                        <a href="/balance" class="count-prof">
                            <div class="cont">
                                <p><%= Number(currentUser.total_balance || 0).toLocaleString('ru-RU') %></p>
                                <svg width="17" height="20" viewBox="0 0 17 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M1.87573 19.9919V-5.79357e-05H8.79173C11.3304 -5.79357e-05 13.2251 0.550609 14.4757 1.65194C15.7451 2.75328 16.3797 4.32128 16.3797 6.35594C16.3797 7.51328 16.1371 8.60528 15.6517 9.63194C15.1851 10.6399 14.4011 11.4613 13.2997 12.0959C12.1984 12.7306 10.6957 13.0573 8.79173 13.0759H7.27973V19.9919H1.87573ZM-0.000273418 18.1999V14.9239H10.7797V18.1999H-0.000273418ZM-0.000273418 13.0759V8.67994H8.20373V13.0759H-0.000273418ZM8.25973 8.67994C8.72639 8.67994 9.15573 8.59594 9.54773 8.42794C9.95839 8.25994 10.2851 8.00794 10.5277 7.67194C10.7891 7.31728 10.9197 6.88794 10.9197 6.38394C10.9197 5.74928 10.7424 5.25461 10.3877 4.89994C10.0331 4.54528 9.46373 4.36794 8.67973 4.36794H7.27973V8.67994H8.25973Z" fill="white"/>
                                </svg>
                            </div>
                            <button class="plus_count" type="button" data-open-deposit-modal>Пополнить</button>
                        </a>
                    <% } %>

                </div>
            </div>
        </div>
    </main>
    <%- include('partials/confirm-modal') %>
    <script>
        function showConfirm(message, onConfirm, options = {}) {
            const modal = document.getElementById('confirmModal');
            const titleEl = document.getElementById('confirmModalTitle');
            const msgEl = document.getElementById('confirmModalMessage');
            const okBtn = document.getElementById('confirmModalOk');
            const cancelBtn = document.getElementById('confirmModalCancel');
            titleEl.textContent = options.title || 'Подтвердите действие';
            msgEl.textContent = message;
            okBtn.textContent = options.confirmText || 'Подтвердить';
            cancelBtn.style.display = options.hideCancel ? 'none' : 'inline-block';
            modal.style.display = 'flex';
            const cleanup = () => { modal.style.display = 'none'; okBtn.onclick = null; };
            okBtn.onclick = () => { cleanup(); onConfirm(); };
            cancelBtn.onclick = cleanup;
        }
        function closeConfirm() {
            document.getElementById('confirmModal').style.display = 'none';
        }
        function showAlert(message) {
            showConfirm(message, () => {}, { title: 'Внимание', confirmText: 'OK', hideCancel: true });
        }
    </script>

    <div id="workViewerModal" class="work-viewer-modal" aria-hidden="true">
        <div class="work-viewer-overlay" data-close-work-viewer></div>
        <div class="work-viewer-content" role="dialog" aria-modal="true" aria-label="Просмотр работы">
            <button class="work-viewer-close" type="button" data-close-work-viewer aria-label="Закрыть">&times;</button>
            <h3 id="workViewerTitle"></h3>
            <div class="work-viewer-gallery" data-viewer-gallery>
                <button class="gallery-arrow gallery-arrow-left" type="button" data-viewer-prev aria-label="Предыдущее изображение">&#10094;</button>
                <div class="work-viewer-track" id="workViewerTrack"></div>
                <button class="gallery-arrow gallery-arrow-right" type="button" data-viewer-next aria-label="Следующее изображение">&#10095;</button>
            </div>
            <div class="work-viewer-dots" id="workViewerDots"></div>
            <p id="workViewerDescription"></p>
            <div id="workViewerStats" class="work-stats"></div>
        </div>
    </div>

    <div id="deleteWorkModal" class="delete-work-modal" aria-hidden="true">
        <div class="delete-work-modal-overlay" data-close-delete-modal></div>
        <div class="delete-work-modal-content" role="dialog" aria-modal="true" aria-labelledby="deleteWorkModalTitle">
            <button class="delete-work-modal-close" type="button" data-close-delete-modal aria-label="Закрыть">&times;</button>
            <h2 id="deleteWorkModalTitle">Удалить работу</h2>
            <form class="delete-work-form" id="deleteWorkForm">
                <div class="delete-work-form-group">
                    <p class="delete-work-modal-text">
                        Вы уверены, что хотите удалить эту работу? <br>Действие нельзя отменить.
                    </p>
                </div>
                <p class="delete-work-validation-error" id="deleteWorkValidationError" role="alert" style="display:none;"></p>
                <button type="submit" class="delete-work-submit-btn">Удалить</button>
            </form>
            <div class="report-success-state" id="deleteWorkSuccessState">
                <div class="success-content" role="status">
