<div id="confirmModal" class="confirm-modal" style="display:none;">
    <div class="confirm-modal-overlay" onclick="closeConfirm()"></div>
    <div class="confirm-modal-content">
        <h3 id="confirmModalTitle">Подтвердите действие</h3>
        <p id="confirmModalMessage">Вы уверены?</p>
        <div class="confirm-modal-actions">
            <button type="button" id="confirmModalCancel" class="secondary-btn" onclick="closeConfirm()">Отмена</button>
            <button type="button" id="confirmModalOk" class="primary-btn">Подтвердить</button>
        </div>
    </div>
</div>
