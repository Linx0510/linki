<div id="adminNotificationModal" class="admin-notification-modal" style="display:none;">
    <div class="admin-notification-overlay" onclick="closeAdminNotification()"></div>
    <div class="admin-notification-content">
        <div class="admin-notification-header">
            <h3 id="notificationTitle">Успешно</h3>
            <button class="notification-close" onclick="closeAdminNotification()">&times;</button>
        </div>
        <div class="admin-notification-body">
            <div id="notificationIcon" class="notification-icon success">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <p id="notificationMessage">Действие выполнено успешно</p>
        </div>
        <div class="admin-notification-actions">
            <button type="button" class="primary-btn" onclick="closeAdminNotification()">Закрыть</button>
        </div>
    </div>
</div>
