<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Обращения | Линити</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/admin-notification.css">
</head>
<body>
    <main>
        <%- include('../partials/header-actions') %>
        <section class="admin-container">

            <div class="admin-main">
                <div class="admin-header">
                    <h1>Обращения</h1>

                </div>

                <div class="content-card feedback-card">
                    <div class="content-card-header">
                        <div>
                            <h2>Обращения с главной страницы</h2>
                            <p>Всего сообщений: <strong><%= total %></strong></p>
                        </div>
                        <form action="/admin/feedback" method="get" class="filters feedback-filters">
                            <input type="text" name="search" value="<%= search %>" placeholder="Поиск по имени, email или тексту">
                            <button type="submit" class="primary-btn">Найти</button>
                            <% if (search) { %>
                                <a href="/admin/feedback" class="reset-link">Сбросить</a>
                            <% } %>
                        </form>
                    </div>

                    <table class="activity-table feedback-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Отправитель</th>
                                <th>Сообщение</th>
                                <th>Дата</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (feedback.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="empty-state">Сообщений пока нет</td>
                                </tr>
                            <% } %>
                            <% feedback.forEach(item => { %>
                                <tr>
                                    <td>#<%= item.id %></td>
                                    <td>
                                        <strong><%= item.name %></strong>
                                        <small><a href="mailto:<%= item.email %>"><%= item.email %></a></small>
                                    </td>
                                    <td class="feedback-message"><%= item.message %></td>
                                    <td><%= new Date(item.created_at).toLocaleString('ru-RU') %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>

                    <% if (totalPages > 1) { %>
                        <div class="pagination">
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <a class="pagination-link <%= i === page ? 'active' : '' %>" href="/admin/feedback?page=<%= i %><%= search ? `&search=${encodeURIComponent(search)}` : '' %>"><%= i %></a>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
                    <%- include('admin-sidebar', { currentPath: '/admin/feedback' }) %>

        </section>
    </main>
    
    <%- include('../partials/admin-notification-modal') %>
    <script src="/js/admin-notification.js"></script>
</body>
</html>
