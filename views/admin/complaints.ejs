<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Жалобы | Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/admin-notification.css">
</head>
<body>
  <main>
    <%- include('../partials/header-actions') %>
    <section class="admin-container">
      <div class="admin-main">
        <div class="admin-header"><h1>Жалобы</h1></div>
        <section class="content-card">
          <form class="filters" method="get" action="/admin/complaints">
            <select name="status">
              <option value="all">Все</option>
              <option value="pending" <%= status==='pending'?'selected':'' %>>На рассмотрении</option>
              <option value="resolved" <%= status==='resolved'?'selected':'' %>>Решена</option>
              <option value="rejected" <%= status==='rejected'?'selected':'' %>>Отклонена</option>
            </select>
            <button type="submit" class="primary-btn">Фильтровать</button>
          </form>
          <table class="activity-table">
            <thead><tr><th>ID</th><th>Отправитель</th><th>Объект</th><th>Причина</th><th>Статус</th><th>Действия</th></tr></thead>
            <tbody>
            <% complaints.forEach(c => { %>
              <tr>
                <td><a href="/admin/complaints/<%= c.id %>" style="color: #1976d2; text-decoration: none; font-weight: 600;"><%= c.id %></a></td>
                <td><%= c.sender_first_name %> <%= c.sender_last_name %><small><%= c.sender_email %></small></td>
                <td><span><%= c.target_type === 'service' ? 'Услуга' : (c.target_type === 'order' ? 'Задача' : 'Проект') %></span><br><%= c.target_title %></td>
                <td><%= c.reason_name %></td>
                <td><span class="status-badge status-<%= c.status %>"><%= statusLabel(c.status, 'complaint') %></span></td>
                <td>
                  <a href="/admin/complaints/<%= c.id %>" class="small-btn">Просмотр</a>
                  <form method="post" action="/admin/complaints/<%= c.id %>/resolve" class="inline-form"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="status" value="resolved"><button class="small-btn">Принять</button></form>
                  <% if (c.target_type === 'work') { %><form method="post" action="/admin/complaints/<%= c.id %>/resolve" class="inline-form"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="status" value="resolved"><input type="hidden" name="action" value="block_work"><button class="small-btn danger-btn">Блок проект</button></form><% } %>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </section>
      </div>
      <%- include('admin-sidebar', { currentPath: '/admin/complaints' }) %>
    </section>
  </main>
  
  <%- include('../partials/admin-notification-modal') %>
  <script src="/js/admin-notification.js"></script>
</body>
</html>
