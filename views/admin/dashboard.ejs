<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админ-панель | Линити</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/admin-notification.css">
</head>
<body>
    <main>
        <%- include('../partials/header-actions') %>
        <section class="admin-container">
            <div class="admin-main">
                <div class="admin-header">
                    <h1>Дашборд</h1>
                </div>

                <div class="stats-grid">
                    <div class="stat-card"><div class="stat-info"><h3><%= stats.total_users %></h3><p>Пользователи</p></div></div>
                    <div class="stat-card"><div class="stat-info"><h3><%= stats.total_works %></h3><p>Работы</p></div></div>
                    <div class="stat-card"><div class="stat-info"><h3><%= stats.total_orders %></h3><p>Задачи</p></div></div>
                    <div class="stat-card"><div class="stat-info"><h3><%= stats.pending_complaints %></h3><p>Жалобы</p></div></div>
                    <div class="stat-card"><div class="stat-info"><h3><%= stats.total_feedback %></h3><p>Сообщения</p></div></div>
                    <div class="stat-card"><div class="stat-info"><h3><%= stats.active_orders %></h3><p>Активные задачи</p></div></div>
                    <div class="stat-card"><div class="stat-info"><h3><%= Number(stats.total_revenue || 0).toLocaleString('ru-RU') %> ₽</h3><p>Выручка</p></div></div>
                </div>

                <div class="activity-chart-card">
                    <div class="activity-chart-header">
                        <h3>Активность платформы</h3>
                        <span class="activity-chart-period">За последние 30 дней</span>
                    </div>
                    <% if (dailyStats.length > 0) { %>
                        <div class="activity-chart-wrap">
                            <canvas id="activityChart"></canvas>
                        </div>
                        <script id="dailyStatsData" type="application/json"><%- JSON.stringify(dailyStats) %></script>
                    <% } else { %>
                        <p class="chart-empty-state">Данные по активности пока не собраны</p>
                    <% } %>
                </div>
            </div>
            <%- include('admin-sidebar', { currentPath: '/admin/dashboard' }) %>
        </section>
    </main>

    <%- include('../partials/admin-notification-modal') %>
    
    <% if (dailyStats.length > 0) { %>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script src="/js/admin-dashboard.js"></script>
    <% } %>
    <script src="/js/admin-notification.js"></script>
</body>
</html>
