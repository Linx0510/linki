<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Отзывы | Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/admin-notification.css">
</head>
<body>
  <main>
    <%- include('../partials/header-actions') %>
    <section class="admin-container">
      <div class="admin-main">
        <div class="admin-header"><h1>Модерация отзывов</h1></div>
        <section class="content-card">
          <form class="filters" method="get" action="/admin/reviews">
            <select name="type">
              <option value="all" <%= type==='all'?'selected':'' %>>Все типы отзывов</option>
              <option value="service" <%= type==='service'?'selected':'' %>>Отзывы на услуги</option>
              <option value="user" <%= type==='user'?'selected':'' %>>Отзывы на пользователей</option>
              <option value="order" <%= type==='order'?'selected':'' %>>Отзывы на задачи</option>
            </select>
            <select name="status">
              <option value="all" <%= status==='all'?'selected':'' %>>Все статусы</option>
              <option value="pending" <%= status==='pending'?'selected':'' %>>На модерации</option>
              <option value="approved" <%= status==='approved'?'selected':'' %>>Одобрены</option>
              <option value="rejected" <%= status==='rejected'?'selected':'' %>>Отклонены</option>
            </select>
            <button type="submit" class="primary-btn">Фильтровать</button>
          </form>
          <table class="activity-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Тип</th>
                <th>Автор отзыва</th>
                <th>Оценка</th>
                <th>Комментарий</th>
                <th>Статус</th>
                <th>Дата</th>
                <th>Действия</th>
              </tr>
            </thead>
            <tbody>
            <% reviews.forEach(review => { %>
              <tr>
                <td><%= review.id %></td>
                <td><span class="badge"><%= review.type %></span></td>
                <td><%= review.reviewer_first_name %> <%= review.reviewer_last_name %></td>
                <td>
                  <div class="star-rating">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <span class="<%= i <= review.rating ? 'active' : '' %>">★</span>
                    <% } %>
                  </div>
                </td>
                <td><small><%= (review.comment || '').slice(0, 60) %>...</small></td>
                <td><span class="status-badge status-<%= review.status %>">
                  <% if (review.status === 'pending') { %>Ожидает<% } %>
                  <% if (review.status === 'approved') { %>Одобрен<% } %>
                  <% if (review.status === 'rejected') { %>Отклонен<% } %>
                </span></td>
                <td><small><%= new Date(review.created_at).toLocaleDateString('ru-RU') %></small></td>
                <td>
                  <% if (review.status === 'pending') { %>
                    <form method="post" action="/admin/reviews/<%= review.id %>/approve" class="inline-form">
                      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                      <button class="small-btn">Одобрить</button>
                    </form>
                    <form method="post" action="/admin/reviews/<%= review.id %>/reject" class="inline-form">
                      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                      <input type="hidden" name="reason" value="Не прошло модерацию">
                      <button class="small-btn danger-btn">Отклонить</button>
                    </form>
                  <% } else { %>
                    <small>Уже обработан</small>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>

          <% if (total > limit) { %>
            <div class="pagination">
              <% for (let i = 1; i <= totalPages; i++) { %>
                <a class="pagination-link <%= i === page ? 'active' : '' %>" href="/admin/reviews?page=<%= i %>&type=<%= type %>&status=<%= status %>"><%= i %></a>
              <% } %>
            </div>
          <% } %>
        </section>
      </div>
      <%- include('admin-sidebar', { currentPath: '/admin/reviews' }) %>
    </section>
  </main>

  <%- include('../partials/admin-notification-modal') %>
  <script src="/js/admin-notification.js"></script>

  <style>
    .star-rating { display: flex; gap: 2px; }
    .star-rating span { color: #ccc; font-size: 14px; }
    .star-rating span.active { color: #FFD700; }
    .badge { display: inline-block; padding: 4px 8px; background: #e0e0e0; border-radius: 4px; font-size: 12px; font-weight: 600; }
    .status-badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; }
    .status-badge.status-pending { background: #fff3cd; color: #856404; }
    .status-badge.status-approved { background: #d4edda; color: #155724; }
    .status-badge.status-rejected { background: #f8d7da; color: #721c24; }
    .inline-form { display: inline; margin: 0 2px; }
    .inline-form button { padding: 4px 8px; font-size: 12px; }
    .pagination { text-align: center; margin-top: 20px; }
    .pagination-link { display: inline-block; padding: 8px 12px; margin: 0 4px; border: 1px solid #ddd; border-radius: 4px; text-decoration: none; color: #1976d2; }
    .pagination-link.active { background: #1976d2; color: white; }
  </style>
</body>
</html>
